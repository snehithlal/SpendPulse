{
  "name": "spendpulse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && next dev --webpack",
    "build": "node scripts/prepare-assets.mjs && next build --webpack",
    "start": "node scripts/serve-preview.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "format": "biome format --write .",
    "typecheck:backend": "node scripts/check-backend.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.119.2",
    "@tanstack/react-query": "5.108.4",
    "clsx": "2.1.1",
    "lucide-react": "1.80.0",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.1",
    "tailwind-merge": "3.7.1",
    "tesseract.js": "7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@electric-sql/pglite": "0.6.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "deno": "2.9.6",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "type": "module"
}
