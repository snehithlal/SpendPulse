  <%= render Ui::ListItemComponent.new(name: "Categories", path: "/categories", active: current_page?(categories_path), icon_classes: ["bi", "bi-folder"]) %>
  <%= render Ui::ListItemComponent.new(name: "Reports", path: "#", active: false, icon_classes: ["bi", "bi-bar-chart-fill"]) %>
